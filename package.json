{
  "name": "agnostic-spotme",
  "version": "0.1.0",
  "description": "SpotMe, gym mode for coding agents, for any harness: Droid, Claude Code, Codex CLI, Cursor, Gemini CLI, OpenCode and Pi.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "spotme": "dist/cli.mjs"
  },
  "exports": {
    "./opencode": "./dist/opencode.js",
    "./pi": "./src/pi.ts"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target node --format esm --outfile dist/cli.mjs && bun build src/opencode.ts --target bun --format esm --outfile dist/opencode.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 test/*.test.ts",
    "smoke": "npm run build && node scripts/smoke.ts"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin",
    "spotme",
    "gym-mode",
    "coding-agent",
    "mcp",
    "hooks"
  ],
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  }
}
